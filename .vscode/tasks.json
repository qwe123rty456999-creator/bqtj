{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "预览站点（本地服务器）",
      "type": "shell",
      "command": "node tools/serve.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "启动 http://localhost:5173 —— 改完文件刷新浏览器即可看到效果"
    },
    {
      "label": "重新生成字幕索引",
      "type": "shell",
      "command": "node tools/build-subs-index.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "扫描 files/subs/ 并写入 assets/data/subs.json"
    },
    {
      "label": "只看字幕统计（不写文件）",
      "type": "shell",
      "command": "node tools/build-subs-index.mjs --stats",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "确认文件名里的语言标记有没有被正确识别"
    }
  ]
}
